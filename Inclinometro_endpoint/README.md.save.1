# inclinometro_endpoint
Control del inclinometro y apertura de tapas del tel 1.5 via mqtt

# Topicos en:
oan/control/1.5m/inclinometro15m/

# Ejemplos de publicaciones que recive el endpoint del control de inclinometro y tapas del 1.5m
##### Cierra tapas de telescopio y buscadores #####
mosquitto_pub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/cerrar_telescopio -n
##### Si desea ver la respuesta del control de tapas e inclinometro a este comando, suscribirse a:
mosquitto_sub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/events/cerrar

##### Abre tapas de telescopio y buscadores #####
mosquitto_pub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/abrir_telescopio -n
##### Si desea ver la respuesta del control de tapas e inclinometro a este comando, suscribirse a:
mosquitto_sub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/events/abrir


##### Proporciona el estado de la posicion de las tapas y la lectura del inclinometro #####
mosquitto_pub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/estado -n
##### Para leer el dato que contesta el inclinometro_endpoint, suscribirse a:
mosquitto_sub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/events/estado


# Para suscribirse a la publicacion periodica del estado usar:
mosquitto_sub -h 192.168.0.243 -t oan/control/1.5m/inclinometro15m/status/response

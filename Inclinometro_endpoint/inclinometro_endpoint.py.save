from endpointlib.devices.socket_device import SocketDevice
from endpointlib.endpoints.endpoint_monitor_device import EndpointMonitorDevice
from endpointlib.helpers.loggers.logger_level import LoggerLevel
from endpointlib.helpers.loggers.logger_manager import LoggerManager
from endpointlib.helpers.loggers.logger_settings import LoggerSettings

LoggerManager.create(LoggerSettings.get_debug_settings(level=LoggerLevel.INFO))
logger = LoggerManager.get_async_logger(name='inclinometro15m')

# Inherit from EndpointMonitorDevice that has a socket device to monitor
class DomeEndpoint(EndpointMonitorDevice):
    def __init__(self, host, port, socket_monitor, delay, command):
        super().__init__(host=host, port=port, device=SocketDevice(socket_monitor[0], socket_monitor[1]),
                            delay=delay, command=command)

    # Define callbacks
    def get_handlers(self):
        handlers = dict()
        handlers['oan/control/1.5m/inclinometro15m/abrir_telescopio'] = self.abrir_telescopio
        handlers['oan/control/1.5m/inclinometro15m/cerrar_telescopio'] = self.cerrar_telescopio
        handlers['oan/control/1.5m/inclinometro15m/estado'] = self.lee_estado
        return handlers

 # Callback defined to be executed every 10(monitor_interval) seconds
    async def on_monitor(self, status):
        #print (status)
        await self.publish('oan/control/1.5m/inclinometro15m/status/response', status)
        await logger.info('[on_dome_monitor]: ' + status)
 
 # Callback executed when topic 'oan/control/1.5m/inclinometro15m/abrir_telescopio'
    async def abrir_telescopio(self, topic, payload):
           #print("payload",payload)
           cmd='ABRIR'
           print(cmd)
           response = await self.send_to_device(cmd)
           await self.publish('oan/control/1.5m/inclinometro15m/events/abrir', response)
           await logger.info('[abrir_telescopio]Response from device: ' + response)
d
 # Callback executed when topic 'oan/control/1.5m/inclinometro15m/cerrar_telescopio'
    async def cerrar_telescopio(self, topic, payload):
           #print("payload",payload)
           cmd='CERRAR'
           print(cmd)
           response = await self.send_to_device(cmd)
           await self.publish('oan/control/1.5m/inclinometro15m/events/cerrar', response)
           await logger.info('[cerrar_telescopio]Response from device: ' + response)

 # Callback executed when topic 'oan/control/1.5m/inclinometro15m/estado'
    async def lee_estado(self, topic, payload):
           #print("payload",payload)
           cmd='ESTADO'
           print(cmd)
           response = await self.send_to_device(cmd)
           await self.publish('oan/control/1.5m/inclinometro15m/events/estado', response)
           await logger.info('[lee_estado]Response from device: ' + response)


#################################################################################################
async def demo():
    # Creates the user defined class DomeEndpoint
    endpoint = DomeEndpoint(host='192.168.0.243', port=1883, socket_monitor=('192.168.0.190', 4545),
                            delay=10, command='ESTADO')

    # Gather loop_forever and socket server tasks
    #await DemoHelper.run(server_port=10001, endpoint=endpoint)
    await endpoint.run_forever()
    await logger.shutdown()

# In order to execute async loop you must start with this instruction 'asyncio.run(tasks...)'
asyncio.run(demo(), debug=True)
